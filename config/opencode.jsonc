// Config GLOBALE OpenCode — commun a tous les projets (elearning7P, ecoledigitale,
// horairiste-python). Le specifique a un projet (MCP, watcher) reste dans son
// opencode.json : les deux niveaux sont charges et fusionnes.
//
// MODELE PAR DEFAUT (01/11/2026) : DeepSeek Flash via OpenRouter, EPINGLE sur le
// fournisseur Morph (fp8). L'epinglage est dans `providers.openrouter.models` :
//   body.provider = { only: ["morph/fp8"], allow_fallbacks: false }
// Prouve par A/B : avec only=["fournisseur/bidon"], OpenRouter repond
// "No allowed providers are available ... provider.only preference permits only".
// ATTENTION : c'est du PAY-AS-YOU-GO (cle OpenRouter plafonnee a 50 $/jour), pas
// l'abonnement OpenCode Console.
//
//  - update: disable — la version est geree par l'image ghcr.io/brohezjulien/
//    opencode-toolbox (tag figé) ; l'auto-update dans un conteneur n'a pas de sens.
//  - compaction.buffer en POURCENTAGE : 60% de la limite du modele.
//  - pas de bloc `providers.limit` : le pourcentage s'adapte a chaque modele.
//
// Source de verite : depot opencode-ops (config/opencode.jsonc).
// Copie versionnee : elearning7P/infra/opencode-global.jsonc

{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/deepseek/deepseek-v4.1-flash-1017",
  "experimental": {
    "todo": true
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 24000
    },
    "buffer": "60%"
  },
  "agents": {
    "architecte": {
      "description": "Conception, plans et arbitrages d'architecture sur le modèle le plus fort (claude-opus-5-5, n°1 en raisonnement et en code, 1M de contexte). À RÉSERVER aux arbitrages : ne pas l'appeler pour une simple recherche ou lecture (modèle coûteux). Peut déléguer la fouille à explore/general.",
      "mode": "all",
      "model": "opencode/claude-opus-5-5",
      "steps": 15,
      "permissions": [
        {"action": "subagent", "resource": "*", "effect": "deny"},
        {"action": "subagent", "resource": "explore", "effect": "allow"},
        {"action": "subagent", "resource": "general", "effect": "allow"}
      ]
    },
    "contre-audit": {
      "description": "Contre-audit À FROID d'une proposition (plan, architecture, diagnostic) : cherche les contresens, les hypothèses non vérifiées et les angles morts. Volontairement un modèle DIFFÉRENT de l'auteur (gemini-4-argon : plus faible taux d'hallucination mesuré). Lecture seule.",
      "mode": "subagent",
      "model": "opencode/gemini-4-argon",
      "steps": 15,
      "system": "Tu es le contradicteur. On te soumet une proposition (plan, architecture, diagnostic) : tu ne la réécris pas, tu cherches ce qui est faux, non prouvé ou fragile. Chaque objection cite une preuve (fichier:ligne, chiffre, document) et se classe : bloquant / majeur / mineur. Tu vérifies aussi les hypothèses implicites et les angles morts (ce que la proposition ne traite pas). Si tout tient, dis-le franchement : ne fabrique pas d'objections pour justifier ta présence.",
      "permissions": [
        {"action": "edit", "resource": "*", "effect": "deny"},
        {"action": "shell", "resource": "*", "effect": "deny"},
        {"action": "shell", "resource": "cat *", "effect": "allow"},
        {"action": "shell", "resource": "grep *", "effect": "allow"},
        {"action": "shell", "resource": "rg *", "effect": "allow"},
        {"action": "shell", "resource": "find *", "effect": "allow"},
        {"action": "shell", "resource": "ls *", "effect": "allow"},
        {"action": "shell", "resource": "wc *", "effect": "allow"},
        {"action": "shell", "resource": "git status *", "effect": "allow"},
        {"action": "shell", "resource": "git diff *", "effect": "allow"},
        {"action": "shell", "resource": "git log *", "effect": "allow"},
        {"action": "subagent", "resource": "*", "effect": "deny"}
      ]
    },
    "explore": {
      "description": "Cherche et lit le code sans modifier — deepseek-v4.1-flash-1017 via Morph : même prix que le flash, meilleur raisonnement pour la fouille et l'inventaire. Feuille : ne lance aucun sous-agent.",
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v4.1-flash-1017",
      "steps": 30,
      "permissions": [
        {"action": "subagent", "resource": "*", "effect": "deny"}
      ]
    },
    "general": {
      "description": "Recherche et analyse multi-étapes (plusieurs fichiers, recoupement, audit) — deepseek-v4.1-flash-1017 via Morph : même prix que le flash, mais meilleur raisonnement. Feuille : ne lance aucun sous-agent.",
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v4.1-flash-1017",
      "steps": 30,
      "permissions": [
        {"action": "subagent", "resource": "*", "effect": "deny"}
      ]
    },
    "review": {
      "description": "Relecture d'un diff en contexte NEUF (neutre) : bugs, régressions, failles, secrets committés, tests manquants. Rend une liste de constats classés. À appeler après une implémentation, surtout avant un commit/push significatif.",
      "mode": "subagent",
      "model": "opencode/deepseek-v4-pro#high",
      "steps": 20,
      "system": "Tu es un relecteur de code. Tu ne modifies JAMAIS de fichier : tu observes, tu vérifies, tu rends un rapport. Commence par lire le diff (git status, git diff, git diff --staged) et les fichiers concernés. Classe tes constats par sévérité (bloquant / majeur / mineur / remarque), chacun avec fichier:ligne et une correction en une phrase. Couvre explicitement : bugs, régressions, failles de sécurité, secrets committés, tests manquants, écarts avec AGENTS.md. Ne résume pas le code et ne félicite pas : seulement les constats. Si tu ne trouves rien, dis-le franchement.",
      "permissions": [
        {"action": "edit", "resource": "*", "effect": "deny"},
        {"action": "shell", "resource": "*", "effect": "deny"},
        {"action": "shell", "resource": "git status *", "effect": "allow"},
        {"action": "shell", "resource": "git diff *", "effect": "allow"},
        {"action": "shell", "resource": "git log *", "effect": "allow"},
        {"action": "shell", "resource": "git show *", "effect": "allow"}
      ]
    }
  },
  "commands": {
    "audit-horaire": {
      "description": "Audit + conception du module horaire (sauvegarde, activites, groupements, FET, ergonomie/DnD)",
      "template": "AUDIT + CONCEPTION — MODULE HORAIRE (ecoledigitale)\n\nMODÈLES ET RÔLES (à respecter : c'est ce qui fait la qualité du résultat)\n- Toi, agent principal (GLM-5.3-Flash) : tu orchestres, tu vérifies et tu rédiges le rapport. Tu ne produis PAS la conception finale toi-même.\n- `general` (GLM-5.3-Flash) : lecture et inventaire de masse. Rapide, pas cher.\n- `architecte` (Claude Opus 5.5, le modèle le plus fort) : c'est LUI qui rédige la phase 3. Tu lui passes l'inventaire factuel, jamais tes conclusions.\n- `contre-audit` (Gemini 4 Argon, volontairement un autre modèle) : il relit la proposition en phase 5 et cherche les contresens.\n- Si un sous-agent est indisponible : signale-le et continue avec le suivant. Ne remplace jamais `architecte` par toi-même sans le dire explicitement dans le rapport.\n\nCONTEXTE (à lire avant d'agir)\n- Le module horaire a été beaucoup bricolé. Les commentaires du code et les documents de docs/ ne sont PAS fiables : de mauvais codages ont déjà fait prendre de fausses décisions lors de générations passées. Tu ne reprends aucune conclusion sans la vérifier dans le code.\n- Nous venons de faire 3 jours de refactoring : juge le code tel qu'il est, pas l'historique git.\n- Objectif : repartir sur des pages NOUVELLES et propres. On NE réutilise PAS le code qui bugue. On garde l'esprit du design de l'ancienne UI « mise en place » mais l'implémentation est neuve.\n- Solveur : FET (la version « school » que nous utilisons, mise à jour récemment). On ne fait PLUS de prétraitement de données avant l'envoi : cela causait trop de bugs. FET doit recevoir des données propres.\n- Le service Python vit dans le dépôt frère /root/workspace/horairiste-python (le sous-module de ce dépôt est vide).\n\nPHASE 0 — SAUVEGARDE (à faire en premier, en LECTURE seule)\n- Repère le contenu de « horaire Nov 1 Copie » et du snapshot d'octobre (sans F1 ni souhait).\n- Produis un export autonome, lisible et réimportable (JSON ; un .md récapitulatif en plus si utile) qui permettra à l'horairiste de retrouver ses données dans la nouvelle interface sans tout redéfinir manuellement.\n- Cet export ne doit dépendre d'aucune table du nouveau schéma.\n- Si une donnée est ambiguë, note-la et continue : ne bloque pas.\n\nPHASE 1 — AUDIT FACTUEL (lecture seule, par `general`)\nPérimètre : src/app/cockpit/horaire/ + les fichiers de src/lib/ qu'il importe directement + le schéma de données concerné + /root/workspace/horairiste-python.\nInventaire factuel : fichiers, rôles, server actions, appels DB, composants, dépendances sortantes, et surtout COMMENT les données sont transformées avant FET (le prétraitement à supprimer).\nChaque constat porte fichier:ligne + un extrait de code cité. Aucune conclusion.\nVérifie toi-même 3 constats au hasard en relisant les lignes citées.\n\nPHASE 2 — LA DOC FET\nVérifie d'abord la version de FET réellement installée (fet-cl --version).\nLis ensuite la documentation officielle FET en ligne (lalescu.ro/liviu/fet/doc/) pour les parties qui touchent : activités, groupes d'élèves, tags d'activités, salles, enseignants, et toutes les contraintes (obligatoires et optionnelles).\nListe les contraintes réellement utiles à notre cas, avec leur nom exact et leurs paramètres. Signale celles qui existent et qu'on n'utilise pas, et celles qu'on simule à tort par du prétraitement.\n\nPHASE 3 — CONCEPTION (rédigée par `architecte`)\nDonne-lui l'inventaire de la phase 1 et les contraintes de la phase 2. Il propose une structure de données propre et pérenne, en tenant compte de :\n- Groupements PAR TYPE DE COURS, paramétrables une fois puis réutilisables : philosophie (telle classe avec telle autre), langues, cours généraux, ateliers. Pour les ateliers, on ne mélange pas des options différentes : à trancher explicitement, avec la règle proposée.\n- L'horairiste doit pouvoir définir PLUSIEURS configurations de groupements et en choisir une avant de générer, au lieu du choix unique actuel qui produisait des trous pour les élèves et des contraintes non respectées.\n- Les ACTIVITÉS comme entité de première classe (comme dans l'UI de FET), sans étape de prétraitement : c'est l'activité qui porte le regroupement.\n- Le lien avec FET : quelle entité devient quelle entité FET.\n- L'import de la sauvegarde de la phase 0.\n- La structure doit rendre le glisser-déposer NATUREL : classes, matières, groupements et activités sont des objets manipulables.\n\nPHASE 4 — ERGONOMIE ET INTERACTION (exigence de PREMIER RANG)\nL'horairiste n'est pas développeur : l'interface doit être conviviale et se manipuler au glisser-déposer.\n- Le drag & drop est le mode PRINCIPAL de l'écran « mise en place » : glisser une classe/matière/activité sur une autre pour créer un groupement, glisser depuis une palette pour ajouter, glisser hors d'une zone pour retirer.\n- Conserver ce que l'ancienne UI faisait bien : badges de groupes regroupés visuellement, matières à glisser, mini-grilles de disponibilité des profs.\n- Retour immédiat pendant le glisser : cibles valides surlignées, cibles invalides grisées, et la règle qui bloque expliquée en clair (pas un refus muet).\n- Annulation (undo/redo) et aucune perte de saisie.\n- Utilisable au clavier ET au tactile (tablette), pas seulement à la souris.\n- Rien de « magique » : l'écran doit montrer exactement l'état qui partira vers FET — aucune transformation invisible.\n- Livrable : les écrans (flux et wireframes textuels), les interactions, et une comparaison des bibliothèques de glisser-déposer (maintenue, accessible au clavier, compatible tactile) avec une recommandation argumentée.\n\nPHASE 5 — CONTRE-AUDIT (par `contre-audit`)\nDonne-lui la proposition de la phase 3 en entier. Il cherche : ce qui contredit le code observé, les hypothèses non vérifiées, les angles morts (import des anciennes données, migration, cas des ateliers), et ce qui casserait l'ergonomie. Garde ses objections telles quelles dans le rapport, sans les lisser ; réponds-y point par point.\n\nLIVRABLE\n1. Ce que fait le module aujourd'hui (10 lignes max)\n2. Carte factuelle des fichiers et de leurs dépendances\n3. Ce qui est cassé ou bricolé, avec preuves (fichier:ligne)\n4. Groupements : ce qui existe vs ce qu'il faut\n5. Activités : ce qui manque vs le modèle FET\n6. Contraintes FET à utiliser (liste + justification)\n7. Structure de données proposée + 2 ou 3 scénarios de migration (coût, risque)\n8. Ce qu'on garde du design de l'ancienne UI, ce qu'on refait\n9. Écrans, interactions, ergonomie et bibliothèque de glisser-déposer recommandée\n10. Objections du contre-audit et réponses\n11. Couverture annoncée : fichiers lus / non lus, zones non couvertes, et quel modèle a produit quoi\n\nINTERDITS\n- Aucune écriture en base (SELECT uniquement), aucun seed, aucune migration.\n- Aucun commit, aucun push, aucune modification de fichier existant (l'export de phase 0 excepté).\n- Ne lance jamais le solveur FET ni une génération.\n- Aucune commande bloquante longue.\n- Ne te fie ni aux commentaires ni aux docs périmées : vérifie dans le code."
    }
  },
  "permissions": [
    {"action": "shell", "resource": "*", "effect": "allow"},
    {"action": "shell", "resource": "git push*", "effect": "ask"},
    {"action": "shell", "resource": "git merge*", "effect": "ask"},
    {"action": "shell", "resource": "git rebase*", "effect": "ask"},
    {"action": "shell", "resource": "git tag*", "effect": "ask"},
    {"action": "shell", "resource": "drizzle-kit push*", "effect": "ask"},
    {"action": "shell", "resource": "npm publish*", "effect": "ask"},
    {"action": "shell", "resource": "rm -rf*", "effect": "ask"},
    {"action": "shell", "resource": "*seed*", "effect": "ask"},
    {"action": "shell", "resource": "*drop*", "effect": "ask"},
    {"action": "shell", "resource": "*truncate*", "effect": "ask"},
    {"action": "shell", "resource": "docker*", "effect": "ask"},
    {"action": "shell", "resource": "supabase*", "effect": "ask"},
    {"action": "shell", "resource": "vercel*", "effect": "ask"},
    {"action": "shell", "resource": "psql*", "effect": "ask"},
    {"action": "edit", "resource": "*", "effect": "allow"},
    {"action": "read", "resource": "*", "effect": "allow"},
    {"action": "read", "resource": "*.env", "effect": "ask"},
    {"action": "read", "resource": "*.env.*", "effect": "ask"},
    {"action": "read", "resource": "*.env.local", "effect": "ask"}
  ],
  "update": "disable",
  "providers": {
    "openrouter": {
      "models": {
        "deepseek/deepseek-v4.1-flash-1017": {
          "body": {
            "provider": {
              "only": [
                "morph/fp8"
              ],
              "allow_fallbacks": false
            }
          }
        },
        "openai/gpt-6.1-terra": {
          "body": {
            "provider": {
              "only": [
                "openai"
              ],
              "allow_fallbacks": false
            }
          }
        }
      }
    }
  }
}
